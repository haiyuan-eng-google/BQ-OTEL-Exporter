root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs.
[*.go]
indent_style = tab

[go.mod]
indent_style = tab

# make requires tab-indented recipes.
[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 4

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
