 *
 * Declares the hourly model cost and token view as a Dataform source. It is
 * read by m_gen_ai_model_costs_hourly. See otel_sources.sqlx.
 */
config {
  type: "declaration",
  database: dataform.projectConfig.vars.source_project,
  schema: dataform.projectConfig.vars.source_dataset,
  name: "v_gen_ai_model_costs",
  description: "Hourly GenAI call, token and latency aggregates per model (v_gen_ai_model_costs)."
}
