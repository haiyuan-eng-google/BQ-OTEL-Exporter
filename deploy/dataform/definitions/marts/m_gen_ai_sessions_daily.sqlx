/*
 * Copyright 2026 Google LLC
 * SPDX-License-Identifier: Apache-2.0
 *
 * Daily session mart: v_gen_ai_sessions materialized into a table that is
 * partitioned by session_start_date, clustered by service_name and agent_name,
 * and refreshed incrementally. Same columns as the view, so a dashboard query
 * can read either.
 *
 * The view groups by (service_name, session_start_date, session_id), where
 * session_start_date is the UTC date of a span's start_time, and it computes the
 * token-parent window inside that date. A session whose spans straddle UTC
 * midnight therefore has one row per date, in the view and in this mart.
 *
 * Refresh: every row of a date depends on the spans of that date alone, so an
 * incremental run recomputes whole UTC dates: it deletes the rows whose
 * session_start_date is at or after the date of window_start (the hour-aligned
 * start of the last 3 hours) and inserts the recomputed dates in one
 * transaction. During the first 3 hours of a UTC day this also recomputes the
 * previous date. A rerun is idempotent and a failed run leaves the table
 * unchanged. A first or full-refresh run uses the Unix epoch as window_start and
 * therefore rebuilds every date.
 *
 * Spans that arrive after their date has left the window are not picked up until
 * a full refresh. user_id and agent_name are ANY_VALUE picks of the view: they
 * are arbitrary when a session reports more than one value.
 */
config {
  type: "incremental",
  tags: ["otel_marts"],
  dependencies: ["stg_run_window"],
  description: "Per-session GenAI aggregates per UTC date, refreshed incrementally.",
  bigquery: {
    partitionBy: "session_start_date",
    clusterBy: ["service_name", "agent_name"]
  }
}

pre_operations {
  DECLARE window_start TIMESTAMP DEFAULT ${when(incremental(), `(SELECT rw.window_start FROM ${ref("stg_run_window")} AS rw)`, `TIMESTAMP('1970-01-01 00:00:00+00')`)}
  ---
  ${when(incremental(), `BEGIN TRANSACTION`)}
  ---
  ${when(incremental(), `DELETE FROM ${self()} WHERE session_start_date >= DATE(window_start)`)}
}

SELECT
  session_id,
  user_id,
  service_name,
  agent_name,
  session_start_time,
  session_end_time,
  session_duration_ms,
  turn_count,
  invocation_count,
  tool_call_count,
  error_count,
  total_input_tokens,
  total_output_tokens,
  total_cache_read_input_tokens,
  total_reasoning_tokens,
  session_start_date,
  total_cache_creation_input_tokens,
  llm_call_count,
  agent_invocation_count,
  typed_error_count,
  top_error_types
FROM ${ref("v_gen_ai_sessions")}
WHERE session_start_date >= DATE(window_start)

post_operations {
  ${when(incremental(), `COMMIT TRANSACTION`)}
}
