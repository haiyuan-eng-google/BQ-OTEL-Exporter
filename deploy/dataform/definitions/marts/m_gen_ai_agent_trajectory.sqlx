/*
 * Copyright 2026 Google LLC
 * SPDX-License-Identifier: Apache-2.0
 *
 * Multi-agent trajectory mart: v_gen_ai_agent_trajectory materialized into a
 * table that is partitioned by day, clustered by service_name and trace_id, and
 * refreshed incrementally. Same columns as the view, so a dashboard query can
 * read either, except that status_message is not materialized: with
 * enable_column_level_security the span column it comes from sits behind a
 * policy tag, and a table created by Dataform carries no policy tags. This mart
 * is the only source of the trajectory when the exporter dataset requires a
 * partition filter on its base tables, because the view is not created there.
 *
 * Input: stg_spans_dedup instead of the raw spans. The recursive part of the
 * query, from the parent_ids CTE to the end, is the view's query without its
 * status_message projections; only the spans CTE (its input) differs.
 *
 * Temporary table: Dataform runs the query of an incremental run as
 * INSERT ... SELECT ... FROM (query), and BigQuery rejects WITH RECURSIVE inside
 * that subquery. The pre_operations therefore run the recursive query into the
 * temporary table trajectory_rows, and the query of this file only reads it.
 *
 * Refresh: window_start is the hour-aligned start of the last 3 hours and
 * context_start is 24 hours before it, the reach of the view's recursion windows
 * (a parent up to 24 hours before its child, a child up to 24 hours after its
 * parent). An incremental run recomputes every trace that has at least one span
 * at or after window_start: it deletes the mart rows of those traces whose
 * start_time is at or after context_start and inserts the recomputed rows, all in
 * one transaction. A rerun is idempotent and a failed run leaves the table
 * unchanged. A first or full-refresh run uses the Unix epoch as window_start and
 * therefore rebuilds every trace.
 *
 * Completeness bound: a trace matches the view exactly when the start_time of
 * every one of its spans is at or after context_start. A span older than that is
 * neither read nor rewritten, so a late parent, a child more than 24 hours after
 * its parent, or the step_index numbering of a trace that began before
 * context_start is only corrected by a full refresh. Spans that arrive after a
 * trace has left the window are not picked up until a full refresh. Spans in a
 * parent cycle, or deeper than 16 levels, are not emitted by the view and are not
 * emitted here; assert_no_unhandled_cycles reports them.
 */
config {
  type: "incremental",
  tags: ["otel_marts"],
  dependencies: ["stg_run_window", "stg_spans_dedup", "m_gen_ai_model_costs_hourly", "m_mcp_tool_usage_hourly", "m_gen_ai_sessions_daily"],
  description: "Per-span multi-agent trajectory (depth, agent path, orphan and token-leaf flags), refreshed incrementally.",
  bigquery: {
    partitionBy: "DATE(start_time)",
    clusterBy: ["service_name", "trace_id"]
  }
}

pre_operations {
  DECLARE window_start TIMESTAMP DEFAULT ${when(incremental(), `(SELECT rw.window_start FROM ${ref("stg_run_window")} AS rw)`, `TIMESTAMP('1970-01-01 00:00:00+00')`)}
  ---
  DECLARE context_start TIMESTAMP DEFAULT TIMESTAMP_SUB(window_start, INTERVAL 24 HOUR)
  ---
  CREATE TEMP TABLE touched_traces AS
  SELECT DISTINCT
    s.trace_id,
    s.service_name
  FROM ${ref("stg_spans_dedup")} AS s
  WHERE s.start_time >= window_start
    ${when(incremental(), `OR (
      s.start_time >= context_start
      AND NOT EXISTS (
        SELECT 1
        FROM ${self()} AS m
        WHERE m.start_time >= context_start
          AND m.trace_id = s.trace_id
          AND m.service_name IS NOT DISTINCT FROM s.service_name
          AND m.span_id = s.span_id
      )
    )`)}
  ---
  CREATE TEMP TABLE trajectory_rows AS
  WITH RECURSIVE
    spans AS (
      SELECT
        s.start_time,
        s.end_time,
        s.duration_nano,
        s.duration_ms,
        s.trace_id,
        s.span_id,
        s.parent_span_id,
        s.service_name,
        s.span_name,
        s.span_kind,
        s.status_code,
        s.gen_ai_operation_name,
        s.gen_ai_system,
        s.gen_ai_provider_name,
        s.gen_ai_request_model,
        s.gen_ai_response_model,
        s.gen_ai_agent_id,
        s.gen_ai_agent_name,
        s.gen_ai_agent_version,
        s.gen_ai_main_agent_id,
        s.gen_ai_main_agent_name,
        s.gen_ai_tool_name,
        s.gen_ai_tool_call_id,
        s.gen_ai_usage_input_tokens,
        s.gen_ai_usage_output_tokens,
        s.gen_ai_usage_reasoning_tokens,
        s.adk_session_id,
        s.adk_invocation_id,
        s.adk_user_id,
        s.error_type,
        s.declared_agent_name,
        s.agent_path_name
      FROM ${ref("stg_spans_dedup")} AS s
      WHERE s.start_time >= context_start
        AND EXISTS (
          SELECT 1
          FROM touched_traces AS touched
          WHERE touched.trace_id = s.trace_id
            AND touched.service_name IS NOT DISTINCT FROM s.service_name
        )
      QUALIFY ROW_NUMBER() OVER (
        PARTITION BY s.trace_id, s.service_name, s.span_id
        ORDER BY s.start_time ASC, s.end_time DESC, s.span_name ASC, s.duration_nano DESC
      ) = 1
    ),
    parent_ids AS (
      SELECT DISTINCT
        trace_id,
        service_name,
        parent_span_id AS span_id
      FROM spans
      WHERE parent_span_id IS NOT NULL
        AND parent_span_id != ''
    ),
    trajectory AS (
      SELECT
        s.start_time,
        s.end_time,
        s.duration_nano,
        s.duration_ms,
        s.trace_id,
        s.span_id,
        s.parent_span_id,
        s.service_name,
        s.span_name,
        s.span_kind,
        s.status_code,
        s.gen_ai_operation_name,
        s.gen_ai_system,
        s.gen_ai_provider_name,
        s.gen_ai_request_model,
        s.gen_ai_response_model,
        s.gen_ai_agent_id,
        s.gen_ai_agent_name,
        s.gen_ai_agent_version,
        s.gen_ai_main_agent_id,
        s.gen_ai_main_agent_name,
        s.gen_ai_tool_name,
        s.gen_ai_tool_call_id,
        s.gen_ai_usage_input_tokens,
        s.gen_ai_usage_output_tokens,
        s.gen_ai_usage_reasoning_tokens,
        s.adk_session_id,
        s.adk_invocation_id,
        s.adk_user_id,
        s.error_type,
        0 AS depth,
        s.span_id AS root_span_id,
        CASE
          WHEN s.gen_ai_operation_name IN ('invoke_agent', 'create_agent')
            OR s.declared_agent_name IS NOT NULL
          THEN s.span_id
          ELSE CAST(NULL AS STRING)
        END AS nearest_agent_span_id,
        CASE
          WHEN s.gen_ai_operation_name IN ('invoke_agent', 'create_agent')
            OR s.declared_agent_name IS NOT NULL
          THEN COALESCE(s.declared_agent_name, s.gen_ai_agent_name)
          ELSE CAST(NULL AS STRING)
        END AS nearest_agent_name,
        CASE
          WHEN s.agent_path_name IS NOT NULL THEN [s.agent_path_name]
          ELSE ARRAY<STRING>[]
        END AS agent_path,
        (s.parent_span_id IS NOT NULL AND s.parent_span_id != '') AS is_orphan,
        [s.span_id] AS visited_span_ids
      FROM spans AS s
      LEFT JOIN spans AS p
        ON s.trace_id = p.trace_id
        AND s.parent_span_id = p.span_id
        AND s.service_name IS NOT DISTINCT FROM p.service_name
        AND p.start_time BETWEEN TIMESTAMP_SUB(s.start_time, INTERVAL 24 HOUR) AND TIMESTAMP_ADD(s.start_time, INTERVAL 1 HOUR)
      WHERE s.parent_span_id IS NULL
         OR s.parent_span_id = ''
         OR p.span_id IS NULL

      UNION ALL

      SELECT
        c.start_time,
        c.end_time,
        c.duration_nano,
        c.duration_ms,
        c.trace_id,
        c.span_id,
        c.parent_span_id,
        c.service_name,
        c.span_name,
        c.span_kind,
        c.status_code,
        c.gen_ai_operation_name,
        c.gen_ai_system,
        c.gen_ai_provider_name,
        c.gen_ai_request_model,
        c.gen_ai_response_model,
        c.gen_ai_agent_id,
        c.gen_ai_agent_name,
        c.gen_ai_agent_version,
        c.gen_ai_main_agent_id,
        c.gen_ai_main_agent_name,
        c.gen_ai_tool_name,
        c.gen_ai_tool_call_id,
        c.gen_ai_usage_input_tokens,
        c.gen_ai_usage_output_tokens,
        c.gen_ai_usage_reasoning_tokens,
        c.adk_session_id,
        c.adk_invocation_id,
        c.adk_user_id,
        c.error_type,
        t.depth + 1 AS depth,
        t.root_span_id AS root_span_id,
        CASE
          WHEN c.gen_ai_operation_name IN ('invoke_agent', 'create_agent')
            OR (t.nearest_agent_span_id IS NULL AND c.declared_agent_name IS NOT NULL)
          THEN c.span_id
          ELSE t.nearest_agent_span_id
        END AS nearest_agent_span_id,
        CASE
          WHEN c.gen_ai_operation_name IN ('invoke_agent', 'create_agent')
            OR (t.nearest_agent_span_id IS NULL AND c.declared_agent_name IS NOT NULL)
          THEN COALESCE(c.declared_agent_name, c.gen_ai_agent_name)
          ELSE t.nearest_agent_name
        END AS nearest_agent_name,
        CASE
          WHEN c.agent_path_name IS NOT NULL
            AND (
              ARRAY_LENGTH(t.agent_path) = 0
              OR t.agent_path[SAFE_OFFSET(ARRAY_LENGTH(t.agent_path) - 1)] != c.agent_path_name
            )
          THEN ARRAY_CONCAT(t.agent_path, [c.agent_path_name])
          ELSE t.agent_path
        END AS agent_path,
        t.is_orphan AS is_orphan,
        ARRAY_CONCAT(t.visited_span_ids, [c.span_id]) AS visited_span_ids
      FROM trajectory AS t
      JOIN spans AS c
        ON c.trace_id = t.trace_id
        AND c.parent_span_id = t.span_id
        AND c.service_name IS NOT DISTINCT FROM t.service_name
        AND c.start_time BETWEEN TIMESTAMP_SUB(t.start_time, INTERVAL 1 HOUR) AND TIMESTAMP_ADD(t.start_time, INTERVAL 24 HOUR)
      WHERE t.depth < 16
        AND c.span_id NOT IN UNNEST(t.visited_span_ids)
    ),
    emitted_ancestors AS (
      SELECT
        c.trace_id,
        c.service_name,
        c.span_id AS descendant_span_id,
        c.start_time AS descendant_start_time,
        c.gen_ai_usage_input_tokens IS NOT NULL AS has_input,
        c.gen_ai_usage_output_tokens IS NOT NULL AS has_output,
        c.gen_ai_usage_reasoning_tokens IS NOT NULL AS has_reasoning,
        p.span_id AS ancestor_span_id,
        p.parent_span_id AS ancestor_parent_span_id,
        p.start_time AS ancestor_start_time,
        1 AS hop,
        [c.span_id, p.span_id] AS path_span_ids
      FROM trajectory AS c
      JOIN trajectory AS p
        ON p.trace_id = c.trace_id
        AND p.span_id = c.parent_span_id
        AND p.service_name IS NOT DISTINCT FROM c.service_name
      WHERE p.span_id != c.span_id

      UNION ALL

      SELECT
        ea.trace_id,
        ea.service_name,
        ea.descendant_span_id,
        ea.descendant_start_time,
        ea.has_input,
        ea.has_output,
        ea.has_reasoning,
        p.span_id AS ancestor_span_id,
        p.parent_span_id AS ancestor_parent_span_id,
        p.start_time AS ancestor_start_time,
        ea.hop + 1 AS hop,
        ARRAY_CONCAT(ea.path_span_ids, [p.span_id]) AS path_span_ids
      FROM emitted_ancestors AS ea
      JOIN trajectory AS p
        ON p.trace_id = ea.trace_id
        AND p.span_id = ea.ancestor_parent_span_id
        AND p.service_name IS NOT DISTINCT FROM ea.service_name
      WHERE ea.hop < 32
        AND p.span_id NOT IN UNNEST(ea.path_span_ids)
    ),
    token_parent_coverage AS (
      SELECT
        ea.trace_id,
        ea.service_name,
        ea.ancestor_span_id AS span_id,
        LOGICAL_OR(ea.has_input) AS has_input,
        LOGICAL_OR(ea.has_output) AS has_output,
        LOGICAL_OR(ea.has_reasoning) AS has_reasoning
      FROM emitted_ancestors AS ea
      LEFT JOIN emitted_ancestors AS reverse_path
        ON reverse_path.trace_id = ea.trace_id
        AND reverse_path.service_name IS NOT DISTINCT FROM ea.service_name
        AND reverse_path.descendant_span_id = ea.ancestor_span_id
        AND reverse_path.ancestor_span_id = ea.descendant_span_id
      WHERE (ea.has_input OR ea.has_output OR ea.has_reasoning)
        AND (
          reverse_path.ancestor_span_id IS NULL
          OR ea.descendant_start_time > ea.ancestor_start_time
          OR (
            ea.descendant_start_time = ea.ancestor_start_time
            AND ea.descendant_span_id > ea.ancestor_span_id
          )
        )
      GROUP BY ea.trace_id, ea.service_name, ea.ancestor_span_id
    )
  SELECT
    t.start_time,
    t.end_time,
    t.duration_nano,
    t.duration_ms,
    t.trace_id,
    t.span_id,
    t.parent_span_id,
    t.service_name,
    t.span_name,
    t.span_kind,
    t.status_code,
    t.gen_ai_operation_name,
    t.gen_ai_system,
    t.gen_ai_provider_name,
    t.gen_ai_request_model,
    t.gen_ai_response_model,
    t.gen_ai_agent_id,
    t.gen_ai_agent_name,
    t.gen_ai_agent_version,
    t.gen_ai_main_agent_id,
    t.gen_ai_main_agent_name,
    t.gen_ai_tool_name,
    t.gen_ai_tool_call_id,
    IF(
      COALESCE(token_leaf_check.has_input, FALSE)
      AND (
        (t.gen_ai_usage_output_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_output, FALSE))
        OR (t.gen_ai_usage_reasoning_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_reasoning, FALSE))
      ),
      CAST(NULL AS INT64),
      t.gen_ai_usage_input_tokens
    ) AS gen_ai_usage_input_tokens,
    IF(
      COALESCE(token_leaf_check.has_output, FALSE)
      AND (
        (t.gen_ai_usage_input_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_input, FALSE))
        OR (t.gen_ai_usage_reasoning_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_reasoning, FALSE))
      ),
      CAST(NULL AS INT64),
      t.gen_ai_usage_output_tokens
    ) AS gen_ai_usage_output_tokens,
    IF(
      COALESCE(token_leaf_check.has_reasoning, FALSE)
      AND (
        (t.gen_ai_usage_input_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_input, FALSE))
        OR (t.gen_ai_usage_output_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_output, FALSE))
      ),
      CAST(NULL AS INT64),
      t.gen_ai_usage_reasoning_tokens
    ) AS gen_ai_usage_reasoning_tokens,
    t.adk_session_id,
    t.adk_invocation_id,
    t.adk_user_id,
    t.error_type,
    t.depth,
    t.root_span_id,
    t.nearest_agent_span_id,
    t.nearest_agent_name,
    t.agent_path,
    t.is_orphan,
    ROW_NUMBER() OVER (
      PARTITION BY t.trace_id, t.service_name
      ORDER BY t.start_time ASC, t.span_id ASC
    ) AS step_index,
    (leaf_check.span_id IS NULL) AS is_leaf,
    (
      (t.gen_ai_usage_input_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_input, FALSE))
      OR (t.gen_ai_usage_output_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_output, FALSE))
      OR (t.gen_ai_usage_reasoning_tokens IS NOT NULL AND NOT COALESCE(token_leaf_check.has_reasoning, FALSE))
    ) AS is_token_leaf
  FROM trajectory AS t
  LEFT JOIN parent_ids AS leaf_check
    ON t.trace_id = leaf_check.trace_id
    AND t.span_id = leaf_check.span_id
    AND t.service_name IS NOT DISTINCT FROM leaf_check.service_name
  LEFT JOIN token_parent_coverage AS token_leaf_check
    ON t.trace_id = token_leaf_check.trace_id
    AND t.span_id = token_leaf_check.span_id
    AND t.service_name IS NOT DISTINCT FROM token_leaf_check.service_name
  ---
  ${when(incremental(), `BEGIN TRANSACTION`)}
  ---
  ${when(incremental(), `DELETE FROM ${self()} AS mart
  WHERE mart.start_time >= context_start
    AND EXISTS (
      SELECT 1
      FROM touched_traces AS touched
      WHERE touched.trace_id = mart.trace_id
        AND touched.service_name IS NOT DISTINCT FROM mart.service_name
    )`)}
}

SELECT
  start_time,
  end_time,
  duration_nano,
  duration_ms,
  trace_id,
  span_id,
  parent_span_id,
  service_name,
  span_name,
  span_kind,
  status_code,
  gen_ai_operation_name,
  gen_ai_system,
  gen_ai_provider_name,
  gen_ai_request_model,
  gen_ai_response_model,
  gen_ai_agent_id,
  gen_ai_agent_name,
  gen_ai_agent_version,
  gen_ai_main_agent_id,
  gen_ai_main_agent_name,
  gen_ai_tool_name,
  gen_ai_tool_call_id,
  gen_ai_usage_input_tokens,
  gen_ai_usage_output_tokens,
  gen_ai_usage_reasoning_tokens,
  adk_session_id,
  adk_invocation_id,
  adk_user_id,
  error_type,
  depth,
  root_span_id,
  nearest_agent_span_id,
  nearest_agent_name,
  agent_path,
  is_orphan,
  step_index,
  is_leaf,
  is_token_leaf
FROM trajectory_rows

post_operations {
  ${when(incremental(), `COMMIT TRANSACTION`)}
  ---
  ASSERT NOT EXISTS (
    WITH staged AS (
      SELECT DISTINCT
        trace_id,
        service_name,
        span_id
      FROM ${ref("stg_spans_dedup")}
      WHERE start_time >= context_start
    ),
    emitted AS (
      SELECT
        trace_id,
        service_name,
        span_id,
        COUNT(*) AS emitted_rows
      FROM ${self()}
      WHERE start_time >= context_start
      GROUP BY trace_id, service_name, span_id
    )
    SELECT
      staged.trace_id,
      staged.service_name,
      staged.span_id,
      COALESCE(emitted.emitted_rows, 0) AS emitted_rows,
      IF(emitted.emitted_rows IS NULL, 'span_missing_from_trajectory', 'span_in_trajectory_more_than_once') AS violation
    FROM staged
    LEFT JOIN emitted
      ON staged.trace_id = emitted.trace_id
      AND staged.service_name IS NOT DISTINCT FROM emitted.service_name
      AND staged.span_id = emitted.span_id
    WHERE emitted.emitted_rows IS NULL
      OR emitted.emitted_rows != 1
  )
  ---
  ASSERT NOT EXISTS (
    WITH RECURSIVE
      staged AS (
        SELECT
          trace_id,
          service_name,
          span_id,
          start_time,
          gen_ai_usage_input_tokens AS raw_input_tokens,
          gen_ai_usage_output_tokens AS raw_output_tokens,
          gen_ai_usage_reasoning_tokens AS raw_reasoning_tokens
        FROM ${ref("stg_spans_dedup")}
        WHERE start_time >= context_start
      ),
      trajectory_context AS (
        SELECT
          m.trace_id,
          m.service_name,
          m.span_id,
          m.parent_span_id,
          m.start_time,
          m.is_token_leaf,
          m.gen_ai_usage_input_tokens AS input_tokens,
          m.gen_ai_usage_output_tokens AS output_tokens,
          m.gen_ai_usage_reasoning_tokens AS reasoning_tokens,
          s.gen_ai_usage_input_tokens AS raw_input_tokens,
          s.gen_ai_usage_output_tokens AS raw_output_tokens,
          s.gen_ai_usage_reasoning_tokens AS raw_reasoning_tokens
        FROM ${self()} AS m
        JOIN ${ref("stg_spans_dedup")} AS s
          ON m.trace_id = s.trace_id
          AND m.service_name IS NOT DISTINCT FROM s.service_name
          AND m.span_id = s.span_id
        WHERE m.start_time >= context_start
          AND s.start_time >= context_start
      ),
      emitted_ancestors AS (
        SELECT
          c.trace_id,
          c.service_name,
          c.span_id AS descendant_span_id,
          c.start_time AS descendant_start_time,
          c.raw_input_tokens IS NOT NULL AS has_input,
          c.raw_output_tokens IS NOT NULL AS has_output,
          c.raw_reasoning_tokens IS NOT NULL AS has_reasoning,
          p.span_id AS ancestor_span_id,
          p.parent_span_id AS ancestor_parent_span_id,
          p.start_time AS ancestor_start_time,
          1 AS hop,
          [c.span_id, p.span_id] AS path_span_ids
        FROM trajectory_context AS c
        JOIN trajectory_context AS p
          ON p.trace_id = c.trace_id
          AND p.span_id = c.parent_span_id
          AND p.service_name IS NOT DISTINCT FROM c.service_name
        WHERE p.span_id != c.span_id

        UNION ALL

        SELECT
          ea.trace_id,
          ea.service_name,
          ea.descendant_span_id,
          ea.descendant_start_time,
          ea.has_input,
          ea.has_output,
          ea.has_reasoning,
          p.span_id AS ancestor_span_id,
          p.parent_span_id AS ancestor_parent_span_id,
          p.start_time AS ancestor_start_time,
          ea.hop + 1 AS hop,
          ARRAY_CONCAT(ea.path_span_ids, [p.span_id]) AS path_span_ids
        FROM emitted_ancestors AS ea
        JOIN trajectory_context AS p
          ON p.trace_id = ea.trace_id
          AND p.span_id = ea.ancestor_parent_span_id
          AND p.service_name IS NOT DISTINCT FROM ea.service_name
        WHERE ea.hop < 32
          AND p.span_id NOT IN UNNEST(ea.path_span_ids)
      ),
      token_parent_coverage AS (
        SELECT
          ea.trace_id,
          ea.service_name,
          ea.ancestor_span_id AS span_id,
          LOGICAL_OR(ea.has_input) AS has_input,
          LOGICAL_OR(ea.has_output) AS has_output,
          LOGICAL_OR(ea.has_reasoning) AS has_reasoning
        FROM emitted_ancestors AS ea
        LEFT JOIN emitted_ancestors AS reverse_path
          ON reverse_path.trace_id = ea.trace_id
          AND reverse_path.service_name IS NOT DISTINCT FROM ea.service_name
          AND reverse_path.descendant_span_id = ea.ancestor_span_id
          AND reverse_path.ancestor_span_id = ea.descendant_span_id
        WHERE (ea.has_input OR ea.has_output OR ea.has_reasoning)
          AND (
            reverse_path.ancestor_span_id IS NULL
            OR ea.descendant_start_time > ea.ancestor_start_time
            OR (
              ea.descendant_start_time = ea.ancestor_start_time
              AND ea.descendant_span_id > ea.ancestor_span_id
            )
          )
        GROUP BY ea.trace_id, ea.service_name, ea.ancestor_span_id
      ),
      emitted AS (
        SELECT
          m.trace_id,
          m.service_name,
          m.span_id,
          m.parent_span_id,
          m.start_time,
          m.is_token_leaf,
          m.input_tokens,
          m.output_tokens,
          m.reasoning_tokens,
          m.raw_input_tokens,
          m.raw_output_tokens,
          m.raw_reasoning_tokens,
          COALESCE(cov.has_input, FALSE) AS cov_input,
          COALESCE(cov.has_output, FALSE) AS cov_output,
          COALESCE(cov.has_reasoning, FALSE) AS cov_reasoning,
          (
            (m.raw_input_tokens IS NOT NULL AND NOT COALESCE(cov.has_input, FALSE))
            OR (m.raw_output_tokens IS NOT NULL AND NOT COALESCE(cov.has_output, FALSE))
            OR (m.raw_reasoning_tokens IS NOT NULL AND NOT COALESCE(cov.has_reasoning, FALSE))
          ) AS expected_is_token_leaf
        FROM trajectory_context AS m
        LEFT JOIN token_parent_coverage AS cov
          ON m.trace_id = cov.trace_id
          AND m.span_id = cov.span_id
          AND m.service_name IS NOT DISTINCT FROM cov.service_name
        WHERE m.start_time >= context_start
      ),
      row_violations AS (
        SELECT
          e.trace_id,
          e.service_name,
          e.span_id,
          CASE
            WHEN (e.input_tokens IS NOT NULL AND e.input_tokens IS DISTINCT FROM e.raw_input_tokens)
              OR (e.output_tokens IS NOT NULL AND e.output_tokens IS DISTINCT FROM e.raw_output_tokens)
              OR (e.reasoning_tokens IS NOT NULL AND e.reasoning_tokens IS DISTINCT FROM e.raw_reasoning_tokens)
            THEN 'projected_token_differs_from_raw'
            WHEN NOT e.is_token_leaf
              AND (
                e.expected_is_token_leaf
                OR e.input_tokens IS DISTINCT FROM e.raw_input_tokens
                OR e.output_tokens IS DISTINCT FROM e.raw_output_tokens
                OR e.reasoning_tokens IS DISTINCT FROM e.raw_reasoning_tokens
              )
            THEN 'rollup_token_changed'
            WHEN e.is_token_leaf
              AND (
                (NOT e.cov_input AND e.input_tokens IS DISTINCT FROM e.raw_input_tokens)
                OR (NOT e.cov_output AND e.output_tokens IS DISTINCT FROM e.raw_output_tokens)
                OR (NOT e.cov_reasoning AND e.reasoning_tokens IS DISTINCT FROM e.raw_reasoning_tokens)
              )
            THEN 'rollup_token_changed'
            WHEN e.is_token_leaf
              AND COALESCE(e.input_tokens, e.output_tokens, e.reasoning_tokens) IS NULL
            THEN 'token_leaf_without_tokens'
            ELSE NULL
          END AS violation
        FROM emitted AS e
      ),
      double_counted AS (
        SELECT DISTINCT
          e.trace_id,
          e.service_name,
          e.span_id,
          'token_double_counted_with_child' AS violation
        FROM emitted AS e
        WHERE (e.cov_input OR e.cov_output OR e.cov_reasoning)
          AND (
            (e.is_token_leaf AND NOT e.expected_is_token_leaf)
            OR (e.is_token_leaf AND e.cov_input AND e.input_tokens IS NOT NULL)
            OR (e.is_token_leaf AND e.cov_output AND e.output_tokens IS NOT NULL)
            OR (e.is_token_leaf AND e.cov_reasoning AND e.reasoning_tokens IS NOT NULL)
          )
      ),
      missing AS (
        SELECT
          s.trace_id,
          s.service_name,
          s.span_id,
          'span_missing_from_trajectory' AS violation
        FROM staged AS s
        WHERE (
            s.raw_input_tokens IS NOT NULL
            OR s.raw_output_tokens IS NOT NULL
            OR s.raw_reasoning_tokens IS NOT NULL
          )
          AND NOT EXISTS (
            SELECT 1
            FROM ${self()} AS m
            WHERE m.start_time >= context_start
              AND m.trace_id = s.trace_id
              AND m.service_name IS NOT DISTINCT FROM s.service_name
              AND m.span_id = s.span_id
          )
      )
    SELECT trace_id, service_name, span_id, violation
    FROM row_violations
    WHERE violation IS NOT NULL
    UNION ALL
    SELECT trace_id, service_name, span_id, violation
    FROM double_counted
    UNION ALL
    SELECT trace_id, service_name, span_id, violation
    FROM missing
  )
  ---
  UPDATE ${ref("stg_run_window")} SET is_committed = TRUE WHERE TRUE
}
