/*
 * Copyright 2026 Google LLC
 * SPDX-License-Identifier: Apache-2.0
 *
 * Assertion: the token columns of the trajectory mart keep the is_token_leaf
 * invariants for the spans staged in the last 3 hours. The assertion fails when
 * this query returns a row; violation names the broken rule.
 *
 * is_token_leaf marks the spans whose token usage is not already reported by an
 * emitted descendant, so that summing gen_ai_usage_*_tokens where is_token_leaf
 * is true counts every token once. The view projects a token family as NULL on a
 * row when a descendant already covers it and another family is still
 * uncovered, and keeps the raw count otherwise. Therefore, per span:
 *
 * - span_missing_from_trajectory: a staged span that reports tokens must be in
 *   the mart (a span in a parent cycle or below depth 16 is not, and its tokens
 *   would be lost from every sum).
 * - projected_token_differs_from_raw: a projected token count is NULL or the
 *   raw staged count, never another value.
 * - rollup_token_changed: a row that is not a token leaf keeps all its raw
 *   counts (it is fully covered, so it is a rollup).
 * - token_leaf_without_tokens: a token leaf keeps at least one count.
 * - token_double_counted_with_child: a token leaf never keeps a family that an
 *   emitted direct child (started later) also reports; that would be summed
 *   twice.
 *
 * Spans are paired with their staged row by (trace_id, service_name, span_id,
 * start_time). The window is the one the incremental run recomputes: the
 * hour-aligned start of the last 3 hours (INTERVAL 3 HOUR, as in the marts).
 */
config {
  type: "assertion",
  tags: ["otel_marts"],
  description: "Fails when the token columns of the trajectory mart break the is_token_leaf sum invariants."
}

WITH staged AS (
  SELECT
    trace_id,
    service_name,
    span_id,
    start_time,
    gen_ai_usage_input_tokens AS raw_input_tokens,
    gen_ai_usage_output_tokens AS raw_output_tokens,
    gen_ai_usage_reasoning_tokens AS raw_reasoning_tokens
  FROM ${ref("stg_spans_dedup")}
  WHERE start_time >= TIMESTAMP_TRUNC(TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 3 HOUR), HOUR)
),
emitted AS (
  SELECT
    m.trace_id,
    m.service_name,
    m.span_id,
    m.parent_span_id,
    m.start_time,
    m.is_token_leaf,
    m.gen_ai_usage_input_tokens AS input_tokens,
    m.gen_ai_usage_output_tokens AS output_tokens,
    m.gen_ai_usage_reasoning_tokens AS reasoning_tokens,
    s.raw_input_tokens,
    s.raw_output_tokens,
    s.raw_reasoning_tokens
  FROM ${ref("m_gen_ai_agent_trajectory")} AS m
  JOIN staged AS s
    ON m.trace_id = s.trace_id
    AND m.service_name IS NOT DISTINCT FROM s.service_name
    AND m.span_id = s.span_id
    AND m.start_time = s.start_time
  WHERE m.start_time >= TIMESTAMP_TRUNC(TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 3 HOUR), HOUR)
),
row_violations AS (
  SELECT
    e.trace_id,
    e.service_name,
    e.span_id,
    CASE
      WHEN (e.input_tokens IS NOT NULL AND e.input_tokens IS DISTINCT FROM e.raw_input_tokens)
        OR (e.output_tokens IS NOT NULL AND e.output_tokens IS DISTINCT FROM e.raw_output_tokens)
        OR (e.reasoning_tokens IS NOT NULL AND e.reasoning_tokens IS DISTINCT FROM e.raw_reasoning_tokens)
        THEN 'projected_token_differs_from_raw'
      WHEN NOT e.is_token_leaf
        AND (
          e.input_tokens IS DISTINCT FROM e.raw_input_tokens
          OR e.output_tokens IS DISTINCT FROM e.raw_output_tokens
          OR e.reasoning_tokens IS DISTINCT FROM e.raw_reasoning_tokens
        )
        THEN 'rollup_token_changed'
      WHEN e.is_token_leaf
        AND e.input_tokens IS NULL
        AND e.output_tokens IS NULL
        AND e.reasoning_tokens IS NULL
        THEN 'token_leaf_without_tokens'
    END AS violation
  FROM emitted AS e
),
double_counted AS (
  SELECT DISTINCT
    p.trace_id,
    p.service_name,
    p.span_id,
    'token_double_counted_with_child' AS violation
  FROM emitted AS p
  JOIN emitted AS c
    ON c.trace_id = p.trace_id
    AND c.service_name IS NOT DISTINCT FROM p.service_name
    AND c.parent_span_id = p.span_id
    AND (c.start_time > p.start_time OR (c.start_time = p.start_time AND c.span_id > p.span_id))
  WHERE p.is_token_leaf
    AND (
      (p.input_tokens IS NOT NULL AND c.raw_input_tokens IS NOT NULL)
      OR (p.output_tokens IS NOT NULL AND c.raw_output_tokens IS NOT NULL)
      OR (p.reasoning_tokens IS NOT NULL AND c.raw_reasoning_tokens IS NOT NULL)
    )
),
missing AS (
  SELECT DISTINCT
    s.trace_id,
    s.service_name,
    s.span_id,
    'span_missing_from_trajectory' AS violation
  FROM staged AS s
  WHERE (
      s.raw_input_tokens IS NOT NULL
      OR s.raw_output_tokens IS NOT NULL
      OR s.raw_reasoning_tokens IS NOT NULL
    )
    AND NOT EXISTS (
      SELECT 1
      FROM ${ref("m_gen_ai_agent_trajectory")} AS m
      WHERE m.start_time >= TIMESTAMP_SUB(TIMESTAMP_TRUNC(TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 3 HOUR), HOUR), INTERVAL 24 HOUR)
        AND m.trace_id = s.trace_id
        AND m.service_name IS NOT DISTINCT FROM s.service_name
        AND m.span_id = s.span_id
    )
)
SELECT trace_id, service_name, span_id, violation FROM row_violations WHERE violation IS NOT NULL
UNION ALL
SELECT trace_id, service_name, span_id, violation FROM double_counted
UNION ALL
SELECT trace_id, service_name, span_id, violation FROM missing
